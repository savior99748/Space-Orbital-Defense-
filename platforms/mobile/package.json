{
  "name": "orbital-defense-mobile",
  "version": "0.4.0",
  "private": true,
  "description": "Orbital Defense mobile build (iOS + Android) using Capacitor.",
  "scripts": {
    "build": "node ../../tools/build.mjs mobile",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "icons": "capacitor-assets generate --iconBackgroundColor '#05060f' --splashBackgroundColor '#05060f'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
