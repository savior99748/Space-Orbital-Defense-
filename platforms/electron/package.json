{
  "name": "orbital-defense-desktop",
  "productName": "Ringwarden Orbital Defense",
  "version": "3.1.0",
  "private": true,
  "description": "Ringwarden: Orbital Defense \u2014 desktop edition (Steam, Windows, macOS, Linux).",
  "main": "main.js",
  "steamAppId": 0,
  "scripts": {
    "prestart": "node ../../tools/build.mjs electron",
    "start": "electron .",
    "predist": "node ../../tools/build.mjs electron",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:steam": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "optionalDependencies": {
    "steamworks.js": "^0.4.0"
  },
  "build": {
    "appId": "io.github.savior99748.orbitaldefense",
    "productName": "Ringwarden Orbital Defense",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Ringwarden-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.strategy-games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ringwarden"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/savior99748/Space-Orbital-Defense-.git"
  },
  "author": "savior99748"
}
